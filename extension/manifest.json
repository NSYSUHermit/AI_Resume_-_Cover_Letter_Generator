{
  "manifest_version": 3,
  "name": "AI Resume Builder 側邊欄",
  "version": "0.1.0",
  "description": "在 Chrome 側邊欄開啟 AI Resume Builder，一鍵把目前職缺頁的內容填進 Job description。",

  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "cookies",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://henry-ai-resume-builder.streamlit.app/*",
    "https://share.streamlit.io/*"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "114",

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "開啟 AI Resume Builder 側邊欄"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["https://henry-ai-resume-builder.streamlit.app/*"],
      "js": ["filler.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
